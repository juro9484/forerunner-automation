# Claim Titan Credentials
CLAIM_TITAN_USER=your_email@example.com
CLAIM_TITAN_PASS=your_password
CLAIM_TITAN_URL=https://claimtitan.com/welcome

# Bot Email Configuration (IMAP)
BOT_EMAIL_USER=your_bot_email@gmail.com
BOT_EMAIL_PASS=your_app_specific_password
BOT_EMAIL_IMAP_SERVER=imap.gmail.com
BOT_EMAIL_IMAP_PORT=993

# AI API Keys (choose one)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Configuration
AI_PROVIDER=anthropic
LOG_LEVEL=INFO
BROWSER_HEADLESS=true

# Claude Model Configuration
# General AI model for email summarization and attachment categorization
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Vision model for PDF contract parsing (Opus has better vision capabilities)
CLAUDE_VISION_MODEL=claude-opus-4-5-20251101

# Attachment Handling
# Set to true to actually upload attachments to CRM (false = test mode, just logs)
UPLOAD_ATTACHMENTS_TO_CRM=false

# Client Identification (for multi-client deployments)
CLIENT_ID=forerunner_claims

# Feature Flags - Enable/disable features per client
FEATURE_COMMENTS_ENABLED=true
COMMENTS_UPLOAD_ATTACHMENTS=false
FEATURE_CONTRACT_ADDITION_ENABLED=true
FEATURE_CHECK_DEPOSIT_ENABLED=true

# Email Notifications
NOTIFICATIONS_ENABLED=true
NOTIFICATION_SMTP_SERVER=smtp.gmail.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_FROM_EMAIL=your_notification_email@gmail.com
NOTIFICATION_FROM_PASSWORD=your_app_password
NOTIFICATION_TO_EMAILS=juanrod2000@gmail.com,juan@roaksystems.com,support@roaksystems.com,leif@roaksystems.com

# Healthchecks.io Integration (optional but recommended)
HEALTHCHECKS_ENABLED=true
HEALTHCHECKS_PING_URL=https://hc-ping.com/your-unique-uuid
